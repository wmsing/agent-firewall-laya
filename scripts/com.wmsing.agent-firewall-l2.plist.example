<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wmsing.agent-firewall-l2</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/wmsing/.local/log/agent-firewall-l2/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/wmsing/.local/log/agent-firewall-l2/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/wmsing/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/wmsing/Documents/jev_demo/agent-firewall-laya/scripts/l2-stack.sh</string>
    <string>start</string>
  </array>
</dict>
</plist>
